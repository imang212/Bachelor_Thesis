# Simulace linux/arm64 prostředí pro Raspberry Pi 5 s Hailo-8
FROM python:3.11.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app:/usr/lib/python3/dist-packages"
ENV GST_PLUGIN_PATH=""
ENV GST_PLUGIN_SYSTEM_PATH="/usr/lib/aarch64-linux-gnu/gstreamer-1.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv \ 
    python3-pip \
    python3-dev \
    build-essential \
    cmake \ 
    git \ 
    wget \
    curl \
    ca-certificates \
    pkg-config \
    libopenblas-dev \
    libopencv-dev \
    python3-opencv \
    python3-numpy \
    libatlas-base-dev \
    gcc g++ gfortran \
    libjpeg-dev \ 
    libpng-dev \ 
    libavcodec-dev \ 
    libavformat-dev \
    libswscale-dev \ 
    libv4l-dev \ 
    libxvidcore-dev \ 
    libx264-dev \
    libhdf5-dev \ 
    libhdf5-serial-dev \
    libcap-dev \
    libarchive-dev \
    libavdevice-dev \ 
    libavutil-dev \
    libswresample-dev \
    libfreetype6 \
    ffmpeg \
    gstreamer1.0-tools \
    gstreamer1.0-rtsp \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstrtspserver-1.0-0 \
    libgstrtspserver-1.0-dev \
    gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 \
    gir1.2-gst-rtsp-server-1.0 \
    python3-gi \
    python3-gi-cairo \
    libgirepository1.0-dev \
    libcairo2-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3.11 -m venv /app/venv --system-site-packages
ENV PATH="/app/venv/bin:$PATH"

RUN /app/venv/bin/python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /app/venv/bin/python3.11 -m pip install --no-cache-dir \
        python-dotenv>=1.0.1 \
        paho-mqtt>=2.0.0 \
        shapely>=2.0.1 \
        psycopg2-binary>=2.9.9 \
        requests>=2.31.0

RUN git clone --branch 25.7.0 --depth 1 https://github.com/hailo-ai/hailo-rpi5-examples.git /app/hailo-rpi5-examples && \
    git clone --branch v5.2.0 --depth 1 https://github.com/hailo-ai/hailo_model_zoo.git /app/hailo_model_zoo && \
    git clone --branch v5.2.0 --depth 1 https://github.com/hailo-ai/tappas.git /app/tappas && \
    mkdir -p /home/imang && \
    ln -s /app/hailo-rpi5-examples /home/imang/hailo-rpi5-examples
    
COPY common/ ./app/common/
COPY rpi_src/db/ /app/rpi_src/db/
COPY rpi_src/docker/ /app/rpi_src/docker/
COPY rpi_src/pipeline/ /app/rpi_src/pipeline/
COPY rpi_src/testing_scripts/ /app/rpi_src/testing_scripts/
COPY videos/ ./app/videos/

# Vytvoření testovacího skriptu
RUN echo '#!/bin/bash\n\
source /app/venv/bin/activate\n\
echo "Python verze:"\n\
python --version\n\
python3.11 -c "import gi; gi.require_version(\"Gst\", \"1.0\"); from gi.repository import Gst; Gst.init(None); print(f\"GStreamer: {Gst.version_string()}\")"\n\
python3.11 -c "import cv2; print(f\"OpenCV: {cv2.__version__}\")"\n\
python3.11 -c "import numpy; print(f\"NumPy: {numpy.__version__}\")"\n\
python3.11 -c "import shapely; print(f\"Shapely: {shapely.__version__}\")"\n\
python3.11 -c "import paho.mqtt.client; print(\"Paho-MQTT: OK\")"\n\
' > /app/test_install.sh && chmod +x /app/test_install.sh

# Vytvoření skriptu pro spuštění bashu s aktivovaným venv
RUN printf '#!/bin/bash\n\
set -e\n\
source /app/venv/bin/activate\n\
exec "$@"\n\
' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh
    
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python3.11", "rpi_src/pipeline/DetectionWithGStreamer_pipeline.py", "--enable-mqtt"]
