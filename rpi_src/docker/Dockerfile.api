FROM python:3.11.10-slim-bookworm@sha256:840e180ebcc6e5c8efab209c43f5e40fd2af98cb49db5c7103c90539c56bb30e

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY rpi_src/docker/api_requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY common/ ./common/
COPY rpi_src/pipeline/ ./rpi_src/pipeline/
COPY rpi_src/db/ ./rpi_src/db/

EXPOSE 8000 8501
CMD ["uvicorn", "rpi_src.pipeline.API_with_streamlit:app", "--host", "0.0.0.0", "--port", "8000"]