# IP Camera / Video Stream Configuration
CAMERA_RTSP_URL=rtsp://<username>:<camera password>@<camera ip>/Stream
VIDEO_SOURCE="videos/sample_video.mp4" # Path to video file for testing (optional, overrides CAMERA_RTSP_URL if set)

# Hailo Stream Configuration
HAILO_STREAM_URL="rtsp://<rpi_ip_address>:8554/hailo_stream"

# MQTT Broker
MQTT_BROKER_HOST=mqtt.portabo.cz
MQTT_BROKER_PORT=1883
MQTT_TOPIC=/videoanalyza
MQTT_CLIENT_ID=hailo_tracker_client
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password_here
MQTT_CONNECT_TIMEOUT=10

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traffic_monitoring
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# API & Dashboard Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501